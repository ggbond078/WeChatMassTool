QWidget {
    color: #E6EDF5;
    font: 10pt "Microsoft YaHei UI";
}

QMainWindow,
QWidget#styleSheet {
    background: transparent;
}

QToolTip {
    background-color: #121A23;
    border: 1px solid #2B3D50;
    border-left: 2px solid #22C55E;
    color: #E6EDF5;
    padding: 6px 8px;
}

#bgApp {
    background-color: #0B1015;
    border: 1px solid #1E2A38;
}

#leftMenuBg {
    background-color: #0F161E;
    border-right: 1px solid #1E2A38;
}

#topLogo {
    background-color: #173A26;
    background-image: url(:/images/images/WeChatMass.png);
    background-position: center;
    background-repeat: no-repeat;
    border-radius: 12px;
}

#titleLeftApp {
    color: #F1F5F9;
    font: 600 12pt "Microsoft YaHei UI";
}

#titleLeftDescription {
    color: #4ADE80;
    font: 8pt "Microsoft YaHei UI";
}

#topMenu QPushButton,
#bottomMenu QPushButton {
    background-color: transparent;
    background-position: left center;
    background-repeat: no-repeat;
    border: 1px solid transparent;
    border-radius: 10px;
    color: #9FB0C0;
    font: 600 10.5pt "Microsoft YaHei UI";
    padding-left: 14px;
    text-align: left;
}

#topMenu QPushButton:hover,
#bottomMenu QPushButton:hover,
#toggleButton:hover {
    background-color: #16212C;
    color: #E6EDF5;
}

#topMenu QPushButton:pressed,
#bottomMenu QPushButton:pressed,
#toggleButton:pressed {
    background-color: #1A2D22;
}

#topMenu QPushButton[compact="true"],
#bottomMenu QPushButton[compact="true"],
#toggleButton[compact="true"] {
    background-position: center;
    padding-left: 27px;
    padding-right: 0;
}

#toggleButton {
    background-color: transparent;
    background-position: left center;
    background-repeat: no-repeat;
    border: 1px solid transparent;
    border-radius: 10px;
    color: #7C8FA3;
    font: 600 10pt "Microsoft YaHei UI";
    padding-left: 14px;
    text-align: left;
}

#leftMenuFrame {
    border-top: 1px solid #1E2A38;
}

#contentTopBg {
    background-color: #0F161E;
    border-bottom: 1px solid #1E2A38;
}

#titleRightInfo {
    color: #E6EDF5;
    padding-left: 4px;
}

#rightButtons .QPushButton,
#settingsTopBtn,
#minimizeAppBtn,
#maximizeRestoreAppBtn,
#closeAppBtn {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 8px;
}

#rightButtons .QPushButton:hover,
#settingsTopBtn:hover,
#minimizeAppBtn:hover,
#maximizeRestoreAppBtn:hover {
    background-color: #16212C;
}

#closeAppBtn:hover {
    background-color: #2A1519;
}

#pagesContainer {
    background-color: #0B1015;
}

#bottomBar {
    background-color: #0F161E;
    border-top: 1px solid #1E2A38;
}

#bottomBar QLabel {
    color: #7C8FA3;
    font-size: 9pt;
    padding-left: 12px;
    padding-right: 12px;
}

#extraLeftBox {
    background: transparent;
    border: none;
}

#SettingsSheet {
    background: #111A24;
    border: 1px solid #223041;
    border-radius: 20px;
}

#extraTopBg {
    background: transparent;
    border-bottom: 1px solid #1E2A38;
}

#extraLabel {
    color: #F1F5F9;
    font: 700 13pt "Microsoft YaHei UI";
}

#SettingsSubtitle {
    color: #7C8FA3;
    font-size: 8.5pt;
}

#extraCloseColumnBtn {
    background-color: transparent;
    border: none;
    border-radius: 8px;
}

#extraCloseColumnBtn:hover {
    background-color: #16212C;
}

#extraContent,
#SettingsScroll,
#SettingsPanel {
    background: transparent;
    border: none;
}

#SettingsSection {
    background: transparent;
    border: none;
}

#SettingsDivider {
    background: #1E2A38;
    border: none;
}

#Card {
    background-color: #121A23;
    border: 1px solid #223041;
    border-radius: 16px;
}

#HeroCard {
    background-color: #10231A;
    border: 1px solid #1F4D36;
    border-radius: 20px;
}

#HeroMark {
    background-color: #173A26;
    border: 1px solid #245C3A;
    border-radius: 32px;
}

#StatCard {
    background-color: #121A23;
    border: 1px solid #223041;
    border-radius: 14px;
}

#StepCard {
    background-color: #101821;
    border: 1px solid #1E2A38;
    border-radius: 14px;
}

#ContactImportPanel {
    background: #101821;
    border: 1px dashed #2B3D50;
    border-radius: 20px;
}

#ContactActionList {
    background: transparent;
    border: none;
}

#ContactActionRow {
    background: transparent;
    border: none;
    border-radius: 12px;
}

#ContactActionRow:hover {
    background: #101821;
}

#ContactIcon {
    background: #173A26;
    border: 1px solid #245C3A;
    border-radius: 14px;
}

#ContactDivider {
    background: #1E2A38;
    border: none;
}

#InfoPill {
    background-color: #173A26;
    border: 1px solid #245C3A;
    border-radius: 12px;
    color: #4ADE80;
    font: 600 9pt "Microsoft YaHei UI";
    padding: 7px 12px;
}

#Eyebrow {
    color: #4ADE80;
    font: 700 8.5pt "Microsoft YaHei UI";
}

#HeroTitle {
    color: #F1F7F3;
    font: 700 26pt "Microsoft YaHei UI";
}

#HeroText {
    color: #A7B8AE;
    font-size: 10.5pt;
}

#PageTitle {
    color: #F1F5F9;
    font: 700 17pt "Microsoft YaHei UI";
}

#PageHint {
    color: #8FA1B3;
    font-size: 9.5pt;
}

#SectionTitle {
    color: #E6EDF5;
    font: 700 12pt "Microsoft YaHei UI";
    padding-top: 4px;
}

#CardTitle {
    color: #E6EDF5;
    font: 700 11.5pt "Microsoft YaHei UI";
}

#CardHint {
    color: #7C8FA3;
    font-size: 8.5pt;
}

#StatValue,
#home_pending_value,
#home_progress_value,
#home_status_value {
    color: #4ADE80;
    font: 700 22pt "Microsoft YaHei UI";
}

#StatCaption {
    color: #8FA1B3;
    font-size: 9pt;
}

#StepNumber {
    color: #4ADE80;
    font: 700 11pt "Microsoft YaHei UI";
}

#StepTitle {
    color: #E6EDF5;
    font: 700 11pt "Microsoft YaHei UI";
}

#StepText {
    color: #94A3B8;
    font-size: 9pt;
}

#FieldLabel {
    color: #C8D4E0;
    font: 600 9.5pt "Microsoft YaHei UI";
}

#HelpText {
    color: #94A3B8;
    font-size: 9pt;
}

QLineEdit,
QTextEdit,
QListWidget,
QComboBox {
    background-color: #0C131A;
    border: 1px solid #223041;
    border-radius: 10px;
    color: #E6EDF5;
    padding: 8px 10px;
    selection-background-color: #22C55E;
    selection-color: #052E16;
}

QLineEdit:hover,
QTextEdit:hover,
QListWidget:hover,
QComboBox:hover {
    border-color: #2B3D50;
}

QLineEdit:focus,
QTextEdit:focus,
QListWidget:focus,
QComboBox:focus {
    border-color: #22C55E;
}

QTextEdit {
    padding: 12px;
}

QListWidget::item {
    border-radius: 6px;
    padding: 7px 8px;
}

QListWidget::item:selected {
    background-color: #173A26;
    color: #4ADE80;
}

QComboBox QAbstractItemView {
    background-color: #121A23;
    border: 1px solid #2B3D50;
    border-radius: 8px;
    color: #E6EDF5;
    padding: 6px;
    selection-background-color: #173A26;
    selection-color: #4ADE80;
}

QProgressBar {
    background-color: #0C131A;
    border: 1px solid #223041;
    border-radius: 7px;
    color: #C8D4E0;
    font-size: 8.5pt;
    text-align: center;
}

QProgressBar::chunk {
    background-color: #22C55E;
    border-radius: 6px;
}

QRadioButton {
    color: #C8D4E0;
    spacing: 8px;
}

QRadioButton::indicator {
    background-color: #0C131A;
    border: 1px solid #334155;
    border-radius: 9px;
    height: 18px;
    width: 18px;
}

QRadioButton::indicator:hover {
    border-color: #22C55E;
}

QRadioButton::indicator:checked {
    background-color: #22C55E;
    border: 3px solid #0C131A;
}

QCheckBox[role="chip"] {
    background: transparent;
    border: 1px solid #2B3D50;
    border-radius: 18px;
    color: #C8D4E0;
    font: 600 9pt "Microsoft YaHei UI";
    padding: 7px 14px;
    spacing: 0px;
}

QCheckBox[role="chip"]::indicator {
    height: 0px;
    width: 0px;
}

QCheckBox[role="chip"]:hover {
    background: #16212C;
    border-color: #3A4E63;
    color: #E6EDF5;
}

QCheckBox[role="chip"]:checked {
    background: #173A26;
    border-color: #245C3A;
    color: #4ADE80;
}

QCheckBox[role="chip"]:checked:hover {
    background: #1D4A30;
}

QPushButton[role="primary"] {
    background: #22C55E;
    border: 1px solid #22C55E;
    border-radius: 10px;
    color: #052E16;
    font: 700 10pt "Microsoft YaHei UI";
    padding: 9px 16px;
}

QPushButton[role="primary"]:hover {
    background: #35D36F;
    border-color: #35D36F;
}

QPushButton[role="primary"]:pressed {
    background: #16A34A;
    border-color: #16A34A;
}

QPushButton[role="secondary"] {
    background: transparent;
    border: 1px solid #2B3D50;
    border-radius: 10px;
    color: #D7E3EE;
    font: 600 9.5pt "Microsoft YaHei UI";
    padding: 8px 14px;
}

QPushButton[role="secondary"]:hover {
    background: #16212C;
    border-color: #3A4E63;
}

QPushButton[role="ghost"] {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 10px;
    color: #8FA1B3;
    font: 600 9.5pt "Microsoft YaHei UI";
    padding: 8px 12px;
}

QPushButton[role="ghost"]:hover {
    background: #16212C;
    color: #E6EDF5;
}

#PrimaryButton,
#btn_send_msg {
    background: #22C55E;
    border: 1px solid #22C55E;
    border-radius: 10px;
    color: #052E16;
    font: 700 10pt "Microsoft YaHei UI";
    padding: 9px 16px;
}

#PrimaryButton:hover,
#btn_send_msg:hover {
    background: #35D36F;
    border-color: #35D36F;
}

#PrimaryButton:pressed,
#btn_send_msg:pressed {
    background: #16A34A;
    border-color: #16A34A;
}

#SecondaryButton,
#btn_pause_send,
#btn_export_result,
#btn_add_file,
#btn_import_name_list {
    background: transparent;
    border: 1px solid #2B3D50;
    border-radius: 10px;
    color: #D7E3EE;
    font: 600 9.5pt "Microsoft YaHei UI";
    padding: 8px 14px;
}

#SecondaryButton:hover,
#btn_pause_send:hover,
#btn_export_result:hover,
#btn_add_file:hover,
#btn_import_name_list:hover {
    background: #16212C;
    border-color: #3A4E63;
}

#GhostButton,
#btn_clear_msg,
#btn_clear_file,
#btn_clear_name,
#btn_clear_all,
#btn_export_name_list,
#btn_export_chat_group_name_list {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 10px;
    color: #8FA1B3;
    font: 600 9.5pt "Microsoft YaHei UI";
    padding: 8px 12px;
}

#GhostButton:hover,
#btn_clear_msg:hover,
#btn_clear_file:hover,
#btn_clear_name:hover,
#btn_clear_all:hover,
#btn_export_name_list:hover,
#btn_export_chat_group_name_list:hover {
    background: #16212C;
    color: #E6EDF5;
}

QScrollArea {
    border: none;
}

QScrollBar:horizontal,
QScrollBar:vertical {
    background: transparent;
    border: none;
}

QScrollBar:horizontal {
    height: 8px;
    margin: 0 10px;
}

QScrollBar:vertical {
    margin: 10px 0;
    width: 8px;
}

QScrollBar::handle:horizontal,
QScrollBar::handle:vertical {
    background: #2B3D50;
    border-radius: 4px;
    min-height: 24px;
    min-width: 24px;
}

QScrollBar::handle:horizontal:hover,
QScrollBar::handle:vertical:hover {
    background: #3A4E63;
}

QScrollBar::add-line,
QScrollBar::sub-line,
QScrollBar::add-page,
QScrollBar::sub-page {
    background: none;
    border: none;
}

QMessageBox {
    background-color: #121A23;
}
