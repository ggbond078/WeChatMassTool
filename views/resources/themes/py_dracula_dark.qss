QWidget {
    color: #E2E8F0;
    font: 10pt "Microsoft YaHei UI";
}

QMainWindow,
QWidget#styleSheet {
    background: transparent;
}

QToolTip {
    background-color: #111C2E;
    border: 1px solid #334155;
    border-left: 2px solid #22C55E;
    color: #E2E8F0;
    padding: 6px 8px;
}

#bgApp {
    background-color: #0B1220;
    border: 1px solid #1E293B;
}

#leftMenuBg {
    background-color: #0F172A;
    border-right: 1px solid #1E293B;
}

#topLogo {
    background-color: #12291D;
    background-image: url(:/images/images/WeChatMass.png);
    background-position: center;
    background-repeat: no-repeat;
    border-radius: 10px;
}

#titleLeftApp {
    color: #F8FAFC;
    font: 600 12pt "Microsoft YaHei UI";
}

#titleLeftDescription {
    color: #4ADE80;
    font: 8pt "Microsoft YaHei UI";
}

#topMenu QPushButton,
#bottomMenu QPushButton {
    background-color: transparent;
    background-position: left center;
    background-repeat: no-repeat;
    border: 1px solid transparent;
    border-radius: 10px;
    color: #9FB0C0;
    font: 600 10.5pt "Microsoft YaHei UI";
    padding-left: 14px;
    text-align: left;
}

#topMenu QPushButton:hover,
#bottomMenu QPushButton:hover,
#toggleButton:hover {
    background-color: #162033;
    color: #E2E8F0;
}

#topMenu QPushButton:pressed,
#bottomMenu QPushButton:pressed,
#toggleButton:pressed {
    background-color: #1B2940;
}

#topMenu QPushButton[compact="true"],
#bottomMenu QPushButton[compact="true"],
#toggleButton[compact="true"] {
    background-position: center;
    padding-left: 27px;
    padding-right: 0;
}

#toggleButton {
    background-color: transparent;
    background-position: left center;
    background-repeat: no-repeat;
    border: 1px solid transparent;
    border-radius: 10px;
    color: #64748B;
    font: 600 10pt "Microsoft YaHei UI";
    padding-left: 14px;
    text-align: left;
}

#leftMenuFrame {
    border-top: 1px solid #1E293B;
}

#contentTopBg {
    background-color: #0F172A;
    border-bottom: 1px solid #1E293B;
}

#titleRightInfo {
    color: #E2E8F0;
    padding-left: 4px;
}

#rightButtons .QPushButton,
#settingsTopBtn,
#minimizeAppBtn,
#maximizeRestoreAppBtn,
#closeAppBtn {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
}

#rightButtons .QPushButton:hover,
#settingsTopBtn:hover,
#minimizeAppBtn:hover,
#maximizeRestoreAppBtn:hover {
    background-color: #162033;
}

#closeAppBtn:hover {
    background-color: #2A1519;
}

#pagesContainer {
    background-color: #0B1220;
}

#bottomBar {
    background-color: #0F172A;
    border-top: 1px solid #1E293B;
}

#bottomBar QLabel {
    color: #64748B;
    font-size: 9pt;
    padding-left: 12px;
    padding-right: 12px;
}

#extraLeftBox {
    background: transparent;
    border: none;
}

#SettingsSheet {
    background: #111A24;
    border: 1px solid #24324A;
    border-radius: 10px;
}

#extraTopBg {
    background: transparent;
    border-bottom: 1px solid #1E293B;
}

#extraLabel {
    color: #F8FAFC;
    font: 700 13pt "Microsoft YaHei UI";
}

#SettingsSubtitle {
    color: #64748B;
    font-size: 8.5pt;
}

#extraCloseColumnBtn {
    background-color: transparent;
    border: none;
    border-radius: 6px;
}

#extraCloseColumnBtn:hover {
    background-color: #162033;
}

#extraContent,
#SettingsScroll,
#SettingsPanel {
    background: transparent;
    border: none;
}

#SettingsSection {
    background: transparent;
    border: none;
}

#SettingsDivider {
    background: #1E293B;
    border: none;
}

#Card {
    background-color: #111C2E;
    border: 1px solid #24324A;
    border-radius: 10px;
}

#HeroCard {
    background-color: #0F1F1A;
    border: 1px solid #1F4D36;
    border-radius: 10px;
}

#HeroMark {
    background-color: #12291D;
    border: 1px solid #1F4D36;
    border-radius: 10px;
}

#StatCard {
    background-color: #111C2E;
    border: 1px solid #24324A;
    border-radius: 10px;
}

#StepCard {
    background-color: #0E1726;
    border: 1px solid #1E293B;
    border-radius: 10px;
}

#ContactImportPanel {
    background: #0E1726;
    border: 1px dashed #334155;
    border-radius: 10px;
}

#ContactActionList {
    background: transparent;
    border: none;
}

#ContactActionRow {
    background: transparent;
    border: none;
    border-radius: 10px;
}

#ContactActionRow:hover {
    background: #0E1726;
}

#ContactIcon {
    background: #12291D;
    border: 1px solid #1F4D36;
    border-radius: 10px;
}

#ContactDivider {
    background: #1E293B;
    border: none;
}

#InfoPill {
    background-color: #12291D;
    border: 1px solid #1F4D36;
    border-radius: 10px;
    color: #4ADE80;
    font: 600 9pt "Microsoft YaHei UI";
    padding: 7px 12px;
}

#Eyebrow {
    color: #4ADE80;
    font: 700 8.5pt "Microsoft YaHei UI";
}

#HeroTitle {
    color: #F8FAFC;
    font: 700 26pt "Microsoft YaHei UI";
}

#HeroText {
    color: #94A3B8;
    font-size: 10.5pt;
}

#PageTitle {
    color: #F8FAFC;
    font: 700 17pt "Microsoft YaHei UI";
}

#PageHint {
    color: #94A3B8;
    font-size: 9.5pt;
}

#SectionTitle {
    color: #E2E8F0;
    font: 700 12pt "Microsoft YaHei UI";
    padding-top: 4px;
}

#CardTitle {
    color: #E2E8F0;
    font: 700 11.5pt "Microsoft YaHei UI";
}

#CardHint {
    color: #64748B;
    font-size: 8.5pt;
}

#StatValue,
#home_pending_value,
#home_progress_value,
#home_status_value {
    color: #4ADE80;
    font: 700 22pt "Microsoft YaHei UI";
}

#StatCaption {
    color: #94A3B8;
    font-size: 9pt;
}

#StepNumber {
    color: #4ADE80;
    font: 700 11pt "Microsoft YaHei UI";
}

#StepTitle {
    color: #E2E8F0;
    font: 700 11pt "Microsoft YaHei UI";
}

#StepText {
    color: #94A3B8;
    font-size: 9pt;
}

#FieldLabel {
    color: #CBD5E1;
    font: 600 9.5pt "Microsoft YaHei UI";
}

#HelpText {
    color: #94A3B8;
    font-size: 9pt;
}

QLineEdit,
QTextEdit,
QListWidget,
QComboBox {
    background-color: #0B1524;
    border: 1px solid #334155;
    border-radius: 10px;
    color: #E2E8F0;
    padding: 8px 10px;
    selection-background-color: #22C55E;
    selection-color: #052E16;
}

QLineEdit:hover,
QTextEdit:hover,
QListWidget:hover,
QComboBox:hover {
    border-color: #475569;
}

QLineEdit:focus,
QTextEdit:focus,
QListWidget:focus,
QComboBox:focus {
    border-color: #22C55E;
}

QTextEdit {
    padding: 12px;
}

QListWidget::item {
    border-radius: 6px;
    padding: 7px 8px;
}

QListWidget::item:selected {
    background-color: #12291D;
    color: #4ADE80;
}

QComboBox QAbstractItemView {
    background-color: #111C2E;
    border: 1px solid #334155;
    border-radius: 6px;
    color: #E2E8F0;
    padding: 6px;
    selection-background-color: #12291D;
    selection-color: #4ADE80;
}

QProgressBar {
    background-color: #0B1524;
    border: 1px solid #24324A;
    border-radius: 6px;
    color: #CBD5E1;
    font-size: 8.5pt;
    text-align: center;
}

QProgressBar::chunk {
    background-color: #22C55E;
    border-radius: 6px;
}

QRadioButton {
    color: #CBD5E1;
    spacing: 8px;
}

QRadioButton::indicator {
    background-color: #0B1524;
    border: 1px solid #334155;
    border-radius: 9px;
    height: 18px;
    width: 18px;
}

QRadioButton::indicator:hover {
    border-color: #22C55E;
}

QRadioButton::indicator:checked {
    background-color: #22C55E;
    border: 3px solid #0B1524;
}

QCheckBox[role="chip"] {
    background: transparent;
    border: 1px solid #334155;
    border-radius: 10px;
    color: #CBD5E1;
    font: 600 9pt "Microsoft YaHei UI";
    padding: 7px 14px;
    spacing: 0px;
}

QCheckBox[role="chip"]::indicator {
    height: 0px;
    width: 0px;
}

QCheckBox[role="chip"]:hover {
    background: #162033;
    border-color: #475569;
    color: #E2E8F0;
}

QCheckBox[role="chip"]:checked {
    background: #12291D;
    border-color: #1F4D36;
    color: #4ADE80;
}

QCheckBox[role="chip"]:checked:hover {
    background: #173524;
}

QPushButton[role="primary"] {
    background: #22C55E;
    border: 1px solid #22C55E;
    border-radius: 10px;
    color: #052E16;
    font: 700 10pt "Microsoft YaHei UI";
    padding: 9px 16px;
}

QPushButton[role="primary"]:hover {
    background: #34D399;
    border-color: #34D399;
}

QPushButton[role="primary"]:pressed {
    background: #16A34A;
    border-color: #16A34A;
}

QPushButton[role="secondary"] {
    background: transparent;
    border: 1px solid #334155;
    border-radius: 10px;
    color: #CBD5E1;
    font: 600 9.5pt "Microsoft YaHei UI";
    padding: 8px 14px;
}

QPushButton[role="secondary"]:hover {
    background: #162033;
    border-color: #475569;
}

QPushButton[role="ghost"] {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 10px;
    color: #94A3B8;
    font: 600 9.5pt "Microsoft YaHei UI";
    padding: 8px 12px;
}

QPushButton[role="ghost"]:hover {
    background: #162033;
    color: #E2E8F0;
}

#PrimaryButton,
#btn_send_msg {
    background: #22C55E;
    border: 1px solid #22C55E;
    border-radius: 10px;
    color: #052E16;
    font: 700 10pt "Microsoft YaHei UI";
    padding: 9px 16px;
}

#PrimaryButton:hover,
#btn_send_msg:hover {
    background: #34D399;
    border-color: #34D399;
}

#PrimaryButton:pressed,
#btn_send_msg:pressed {
    background: #16A34A;
    border-color: #16A34A;
}

#SecondaryButton,
#btn_pause_send,
#btn_export_result,
#btn_add_file,
#btn_import_name_list {
    background: transparent;
    border: 1px solid #334155;
    border-radius: 10px;
    color: #CBD5E1;
    font: 600 9.5pt "Microsoft YaHei UI";
    padding: 8px 14px;
}

#SecondaryButton:hover,
#btn_pause_send:hover,
#btn_export_result:hover,
#btn_add_file:hover,
#btn_import_name_list:hover {
    background: #162033;
    border-color: #475569;
}

#GhostButton,
#btn_clear_msg,
#btn_clear_file,
#btn_clear_name,
#btn_clear_all,
#btn_export_name_list,
#btn_export_chat_group_name_list {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 10px;
    color: #94A3B8;
    font: 600 9.5pt "Microsoft YaHei UI";
    padding: 8px 12px;
}

#GhostButton:hover,
#btn_clear_msg:hover,
#btn_clear_file:hover,
#btn_clear_name:hover,
#btn_clear_all:hover,
#btn_export_name_list:hover,
#btn_export_chat_group_name_list:hover {
    background: #162033;
    color: #E2E8F0;
}

QScrollArea {
    border: none;
}

QScrollBar:horizontal,
QScrollBar:vertical {
    background: transparent;
    border: none;
}

QScrollBar:horizontal {
    height: 8px;
    margin: 0 10px;
}

QScrollBar:vertical {
    margin: 10px 0;
    width: 8px;
}

QScrollBar::handle:horizontal,
QScrollBar::handle:vertical {
    background: #334155;
    border-radius: 4px;
    min-height: 24px;
    min-width: 24px;
}

QScrollBar::handle:horizontal:hover,
QScrollBar::handle:vertical:hover {
    background: #475569;
}

QScrollBar::add-line,
QScrollBar::sub-line,
QScrollBar::add-page,
QScrollBar::sub-page {
    background: none;
    border: none;
}

QMessageBox {
    background-color: #111C2E;
}
QComboBox::drop-down {
    border: none;
    width: 24px;
}

QCheckBox {
    color: #CBD5E1;
    spacing: 8px;
}

QCheckBox::indicator {
    background-color: #0B1524;
    border: 1px solid #475569;
    border-radius: 4px;
    height: 14px;
    width: 14px;
}

QCheckBox::indicator:hover {
    border-color: #22C55E;
}

QCheckBox::indicator:checked {
    background-color: #22C55E;
    border-color: #22C55E;
}

QMenu {
    background-color: #111C2E;
    border: 1px solid #24324A;
    border-radius: 6px;
    color: #E2E8F0;
    padding: 4px;
}

QMenu::item {
    background: transparent;
    border-radius: 4px;
    padding: 6px 12px;
}

QMenu::item:selected {
    background-color: #162033;
    color: #4ADE80;
}

QMenu::separator {
    background: #1E293B;
    height: 1px;
    margin: 4px 8px;
}

QMessageBox QLabel {
    color: #E2E8F0;
}
